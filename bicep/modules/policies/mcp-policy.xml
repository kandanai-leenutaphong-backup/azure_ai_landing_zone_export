<!-- Authenticates MCP callers and emits one identity-scoped metric per tools/call request. -->
<policies>
    <inbound>
        <cors allow-credentials="false" terminate-unmatched-request="true">
            <allowed-origins>
                <origin>{{mcp-allowed-origin}}</origin>
            </allowed-origins>
            <allowed-methods preflight-result-max-age="300">
                <method>GET</method>
                <method>POST</method>
                <method>DELETE</method>
                <method>OPTIONS</method>
            </allowed-methods>
            <allowed-headers>
                <header>accept</header>
                <header>authorization</header>
                <header>content-type</header>
                <header>mcp-protocol-version</header>
                <header>mcp-session-id</header>
            </allowed-headers>
            <expose-headers>
                <header>mcp-session-id</header>
            </expose-headers>
        </cors>
        <validate-jwt header-name="Authorization"
                      failed-validation-httpcode="401"
                      failed-validation-error-message="A valid Microsoft Entra access token is required."
                      require-expiration-time="true"
                      require-scheme="Bearer"
                      output-token-variable-name="validated-jwt">
            <openid-config url="https://login.microsoftonline.com/{{entra-tenant-id}}/v2.0/.well-known/openid-configuration" />
            <audiences>
                <audience>{{mcp-entra-audience}}</audience>
            </audiences>
            <required-claims>
                <claim name="scp" match="any">
                    <value>access_as_user</value>
                </claim>
            </required-claims>
        </validate-jwt>
        <set-variable name="mcpUserId" value="@(((Jwt)context.Variables[&quot;validated-jwt&quot;]).Claims.GetValueOrDefault(&quot;oid&quot;, &quot;unknown-user&quot;))" />
        <set-variable name="mcpUserName" value="@{
            var jwt = (Jwt)context.Variables[&quot;validated-jwt&quot;];
            var name = jwt.Claims.GetValueOrDefault(&quot;name&quot;, &quot;&quot;);
            return !string.IsNullOrEmpty(name)
                ? name
                : jwt.Claims.GetValueOrDefault(&quot;preferred_username&quot;, &quot;unknown-user&quot;);
        }" />
        <set-header name="X-Entra-Object-Id" exists-action="override">
            <value>@((string)context.Variables[&quot;mcpUserId&quot;])</value>
        </set-header>
        <set-header name="X-Entra-Display-Name" exists-action="override">
            <value>@((string)context.Variables[&quot;mcpUserName&quot;])</value>
        </set-header>
        <set-header name="X-Entra-Username" exists-action="override">
            <value>@(((Jwt)context.Variables[&quot;validated-jwt&quot;]).Claims.GetValueOrDefault(&quot;preferred_username&quot;, &quot;&quot;))</value>
        </set-header>
        <set-variable name="mcpDepartment" value="@{
            var roles = ((Jwt)context.Variables[&quot;validated-jwt&quot;]).Claims.GetValueOrDefault(&quot;roles&quot;, new string[0]);
            return roles.Length &gt; 0 ? roles[0] : &quot;MCP&quot;;
        }" />
        <set-variable name="mcpToolName" value="@{
            var body = context.Request.Body?.As&lt;JObject&gt;(preserveContent: true);
            return body?[&quot;method&quot;]?.ToString() == &quot;tools/call&quot;
                ? body?[&quot;params&quot;]?[&quot;name&quot;]?.ToString() ?? &quot;unknown-tool&quot;
                : &quot;&quot;;
        }" />
        <rate-limit-by-key calls="30"
                           renewal-period="60"
                           counter-key="@((string)context.Variables[&quot;mcpUserId&quot;])" />
        <base />
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
        <choose>
            <when condition="@(!string.IsNullOrEmpty(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;mcpToolName&quot;, &quot;&quot;)))">
                <emit-metric name="MCP Tool Calls" value="1" namespace="mcp-usage">
                    <dimension name="department" value="@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;mcpDepartment&quot;, &quot;MCP&quot;))" />
                    <dimension name="user" value="@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;mcpUserId&quot;, &quot;unknown-user&quot;))" />
                    <dimension name="userName" value="@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;mcpUserName&quot;, &quot;unknown-user&quot;))" />
                    <dimension name="server" value="@(context.Api.Id)" />
                    <dimension name="tool" value="@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;mcpToolName&quot;, &quot;unknown-tool&quot;))" />
                </emit-metric>
            </when>
        </choose>
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
